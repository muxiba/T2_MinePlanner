# Copie este arquivo para .env.local e preencha com os dados do seu projeto Neon.
# No Vercel, cadastre as mesmas variáveis em Settings → Environment Variables
# (Production e Preview) e faça um novo deploy.
#
# As duas URLs são públicas: a segurança dos dados vem das políticas RLS do banco
# (db/schema.sql). NUNCA coloque aqui a connection string com senha do banco.

# Neon Console → Better Auth → Configure Auth → Auth URL
VITE_NEON_AUTH_URL=https://ep-SEU-ENDPOINT.neonauth.sa-east-1.aws.neon.tech/neondb/auth

# Neon Console → Data API → API URL
VITE_NEON_DATA_API_URL=https://ep-twilight-butterfly-b67jaa0n.apirest.c-2.sa-east-1.aws.neon.tech/neondb/rest/v1

# E-mail para onde as empresas com teste expirado pedem liberação (opcional)
VITE_SUPPORT_EMAIL=
