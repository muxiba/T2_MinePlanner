# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API). No Vercel, cadastre as mesmas variáveis em
# Settings → Environment Variables.
#
# A chave "anon" é pública por natureza: a segurança dos dados vem das políticas
# RLS do banco. NUNCA coloque a chave service_role aqui.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# E-mail para onde as empresas com teste expirado pedem liberação (opcional)
VITE_SUPPORT_EMAIL=
